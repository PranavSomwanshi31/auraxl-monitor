# ==============================================================================
# AuraXL Agentic AI Website Monitor - Environment Example Template
# ==============================================================================

# Server & Environment Settings
PORT=5000
FLASK_ENV=production
SECRET_KEY=your_secret_key_here

# Target Website to Monitor
TARGET_URL=https://www.auraxl.com

# Default Administrator Authentication Credentials
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=AuraXL@2026

# Monitoring Daemon Configuration
MONITOR_INTERVAL_MINUTES=5
AUTO_MONITOR_ENABLED=true
SOUND_ALERTS=true

# Python Runtime
PYTHON_VERSION=3.11.9
